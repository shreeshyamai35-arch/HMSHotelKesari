# ─────────────────────────────────────────────────────────────
# Hotel Kesari — environment for the Docker Compose stack.
# Copy to ".env" (same folder as docker-compose.yml) and edit.
#   cp .env.docker.example .env
# ─────────────────────────────────────────────────────────────

# ─── Public web port (host) ───────────────────────────────
WEB_PORT=80

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=kesari
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=kesari

# ─── Auth ─────────────────────────────────────────────────
# IMPORTANT: replace with a long random string before deploying.
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# ─── App / CORS ───────────────────────────────────────────
# Set to your public origin in production, e.g. https://ops.hotelkesari.com
CORS_ORIGIN=http://localhost

# ─── First-boot seeding ───────────────────────────────────
# Set to "true" for the very first `docker compose up` to create demo
# users/data, then set back to "false". Alternatively run:
#   docker compose exec backend npm run db:seed
SEED_ON_START=false

# ─── Email (SMTP, optional) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hotel Kesari <no-reply@hotelkesari.com>"

# ─── AI Insights (pluggable) ──────────────────────────────
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ─── eZee Absolute PMS (pluggable) ────────────────────────
PMS_PROVIDER=mock
EZEE_API_URL=
EZEE_HOTEL_CODE=
EZEE_AUTH_CODE=

# ─── Notifications / Cron ─────────────────────────────────
CHECK_GRACE_MINUTES=60
ENABLE_CRON=true
