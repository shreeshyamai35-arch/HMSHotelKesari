# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# ─── Database ─────────────────────────────────────────────
# Local dev (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) example:
# DATABASE_URL="postgresql://kesari:kesari@db:5432/kesari?schema=public"

# ─── Email (SMTP, optional) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hotel Kesari <no-reply@hotelkesari.com>"

# ─── AI Insights (pluggable, optional) ────────────────────
# Provider: "mock" (default, no key needed) | "openai"
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ─── eZee Absolute PMS (pluggable, optional) ──────────────
# Provider: "mock" (default) | "ezee"
PMS_PROVIDER=mock
EZEE_API_URL=
EZEE_HOTEL_CODE=
EZEE_AUTH_CODE=

# ─── Notifications / Cron ─────────────────────────────────
# Grace period (minutes) after a scheduled check before flagging "missed"
CHECK_GRACE_MINUTES=60
ENABLE_CRON=true
