# ── Database (Supabase) ──────────────────────────────────────────────────────
# Pooled connection (pgbouncer, port 6543) — used at runtime by Prisma Client
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used only by `prisma migrate deploy`
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGIN="https://hms.daamjigroups.com"

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="4000"
TZ="Asia/Kolkata"

# ── Cron ─────────────────────────────────────────────────────────────────────
# Must be false on Vercel — serverless functions have no persistent process
ENABLE_CRON="false"

# ── SMTP (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Hotel Kesari <no-reply@hotelkesari.com>"

# ── AI (optional) ────────────────────────────────────────────────────────────
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# ── PMS / eZee (optional) ────────────────────────────────────────────────────
PMS_PROVIDER="mock"
EZEE_API_URL=""
EZEE_HOTEL_CODE=""
EZEE_AUTH_CODE=""

# ── Occupancy ────────────────────────────────────────────────────────────────
# Grace period (minutes) after a scheduled check before flagging "missed"
CHECK_GRACE_MINUTES="60"
